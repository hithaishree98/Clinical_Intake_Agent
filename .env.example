# Copy to .env and fill in the required values.
# Never commit .env to version control.

# Required
GEMINI_API_KEY=your-gemini-api-key-here
JWT_SECRET=change-me-to-a-long-random-string
CLINICIAN_PASSWORD=change-me

# Voice (optional — set GROQ_API_KEY to enable the mic button)
# GROQ_API_KEY=gsk-...

# Slack alerts on escalations and intake completion
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# FHIR webhook — posts the bundle to your EHR on intake completion
# COMPLETION_WEBHOOK_URL=https://your-ehr.example.com/intake/bundle
# COMPLETION_WEBHOOK_SECRET=generate-with-secrets.token_hex-32

# Direct FHIR server push (alternative to webhook)
# FHIR_SERVER_URL=http://hapi-fhir:8080/fhir
# FHIR_SERVER_BEARER_TOKEN=

# CORS — restrict in production
# CORS_ALLOWED_ORIGINS=["https://your-domain.com"]
